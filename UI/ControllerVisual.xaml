<UserControl x:Class="ReBind360.UI.ControllerVisual"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="540" Height="340" Background="Transparent">
    <Viewbox Stretch="Uniform">
        <Canvas Width="540" Height="340" Background="Transparent">
            <!-- Neo-Brutalist Hard Drop Shadow for the entire controller body -->
            <Path Fill="#000000" 
                  Data="M 75,76 L 465,76 Q 495,76 495,106 L 495,186 Q 495,216 455,296 Q 425,336 360,306 Q 330,291 270,291 Q 210,291 180,306 Q 115,336 85,296 Q 45,216 45,186 L 45,106 Q 45,76 75,76 Z"/>

            <!-- Controller Main Outer Shell (Chunky 3px solid black border) -->
            <Path Fill="#1E1E26" Stroke="#000000" StrokeThickness="3.5" 
                  Data="M 70,70 L 460,70 Q 490,70 490,100 L 490,180 Q 490,210 450,290 Q 420,330 355,300 Q 325,285 265,285 Q 205,285 175,300 Q 110,330 80,290 Q 40,210 40,180 L 40,100 Q 40,70 70,70 Z"/>

            <!-- Bumpers (LB & RB) with 3px black border -->
            <Path x:Name="LbShape" Fill="#2A2A38" Stroke="#000000" StrokeThickness="3" Data="M 85,45 L 180,52 Q 190,53 190,68 L 75,68 Q 75,55 85,45 Z"/>
            <TextBlock Text="LB" Foreground="#FFFFFF" FontSize="11" FontWeight="Black" Canvas.Left="125" Canvas.Top="49"/>

            <Path x:Name="RbShape" Fill="#2A2A38" Stroke="#000000" StrokeThickness="3" Data="M 445,45 L 350,52 Q 340,53 340,68 L 455,68 Q 455,55 445,45 Z"/>
            <TextBlock Text="RB" Foreground="#FFFFFF" FontSize="11" FontWeight="Black" Canvas.Left="385" Canvas.Top="49"/>

            <!-- Triggers (LT & RT) Gauges - Neo-brutalist styled -->
            <Border Canvas.Left="85" Canvas.Top="12" Width="80" Height="26" Background="#111116" BorderBrush="#000000" BorderThickness="2.5" CornerRadius="4">
                <Grid>
                    <ProgressBar x:Name="LtProgress" Minimum="0" Maximum="1" Value="0" Background="Transparent" Foreground="#00F0FF" BorderThickness="0"/>
                    <TextBlock Text="LT" Foreground="#FFFFFF" FontSize="11" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <Border Canvas.Left="365" Canvas.Top="12" Width="80" Height="26" Background="#111116" BorderBrush="#000000" BorderThickness="2.5" CornerRadius="4">
                <Grid>
                    <ProgressBar x:Name="RtProgress" Minimum="0" Maximum="1" Value="0" Background="Transparent" Foreground="#00F0FF" BorderThickness="0"/>
                    <TextBlock Text="RT" Foreground="#FFFFFF" FontSize="11" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Guide Button (Center Xbox Logo) -->
            <Ellipse x:Name="GuideHalo" Width="46" Height="46" Canvas.Left="242" Canvas.Top="102" Fill="#00FF85" Opacity="0"/>
            <Ellipse x:Name="GuideBtn" Width="38" Height="38" Canvas.Left="246" Canvas.Top="106" Fill="#FFE600" Stroke="#000000" StrokeThickness="3"/>
            <TextBlock Text="X" Foreground="#000000" FontSize="18" FontWeight="Black" Canvas.Left="258" Canvas.Top="111"/>

            <!-- Back & Start Buttons (Neo-brutalist pills) -->
            <Border x:Name="BackBtn" Width="34" Height="18" Canvas.Left="195" Canvas.Top="116" Background="#2A2A38" BorderBrush="#000000" BorderThickness="2" CornerRadius="4">
                <TextBlock Text="BACK" Foreground="#FFFFFF" FontSize="8" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <Border x:Name="StartBtn" Width="34" Height="18" Canvas.Left="301" Canvas.Top="116" Background="#2A2A38" BorderBrush="#000000" BorderThickness="2" CornerRadius="4">
                <TextBlock Text="START" Foreground="#FFFFFF" FontSize="8" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>

            <!-- Left Analog Stick Track & Moving Head -->
            <Ellipse Width="66" Height="66" Canvas.Left="117" Canvas.Top="97" Fill="#121218" Stroke="#000000" StrokeThickness="3"/>
            <Canvas x:Name="LeftStickThumb" Canvas.Left="150" Canvas.Top="130">
                <Ellipse x:Name="LsHalo" Width="42" Height="42" Canvas.Left="-21" Canvas.Top="-21" Fill="#00F0FF" Opacity="0"/>
                <Ellipse x:Name="LsHead" Width="34" Height="34" Canvas.Left="-17" Canvas.Top="-17" Fill="#363646" Stroke="#000000" StrokeThickness="2.5"/>
                <TextBlock Text="LS" Foreground="#FFFFFF" FontSize="9" FontWeight="Black" Canvas.Left="-7" Canvas.Top="-7"/>
            </Canvas>

            <!-- Right Analog Stick Track & Moving Head -->
            <Ellipse Width="66" Height="66" Canvas.Left="292" Canvas.Top="177" Fill="#121218" Stroke="#000000" StrokeThickness="3"/>
            <Canvas x:Name="RightStickThumb" Canvas.Left="325" Canvas.Top="210">
                <Ellipse x:Name="RsHalo" Width="42" Height="42" Canvas.Left="-21" Canvas.Top="-21" Fill="#00F0FF" Opacity="0"/>
                <Ellipse x:Name="RsHead" Width="34" Height="34" Canvas.Left="-17" Canvas.Top="-17" Fill="#363646" Stroke="#000000" StrokeThickness="2.5"/>
                <TextBlock Text="RS" Foreground="#FFFFFF" FontSize="9" FontWeight="Black" Canvas.Left="-7" Canvas.Top="-7"/>
            </Canvas>

            <!-- D-Pad Mechanical Cross -->
            <Canvas Canvas.Left="175" Canvas.Top="200">
                <!-- Track with heavy border -->
                <Path Fill="#121218" Stroke="#000000" StrokeThickness="2.5" 
                      Data="M -13,-36 L 13,-36 L 13,-13 L 36,-13 L 36,13 L 13,13 L 13,36 L -13,36 L -13,13 L -36,13 L -36,-13 L -13,-13 Z"/>
                
                <Rectangle x:Name="DpadUp" Width="22" Height="22" Canvas.Left="-11" Canvas.Top="-34" Fill="#2A2A38" Stroke="#000000" StrokeThickness="1.5" RadiusX="2" RadiusY="2"/>
                <Rectangle x:Name="DpadDown" Width="22" Height="22" Canvas.Left="-11" Canvas.Top="12" Fill="#2A2A38" Stroke="#000000" StrokeThickness="1.5" RadiusX="2" RadiusY="2"/>
                <Rectangle x:Name="DpadLeft" Width="22" Height="22" Canvas.Left="-34" Canvas.Top="-11" Fill="#2A2A38" Stroke="#000000" StrokeThickness="1.5" RadiusX="2" RadiusY="2"/>
                <Rectangle x:Name="DpadRight" Width="22" Height="22" Canvas.Left="12" Canvas.Top="-11" Fill="#2A2A38" Stroke="#000000" StrokeThickness="1.5" RadiusX="2" RadiusY="2"/>
                <Ellipse Width="16" Height="16" Canvas.Left="-8" Canvas.Top="-8" Fill="#1E1E26" Stroke="#000000" StrokeThickness="1.5"/>
            </Canvas>

            <!-- Face Buttons (A, B, X, Y) - Neo-Brutalist High Saturation -->
            <Canvas Canvas.Left="390" Canvas.Top="135">
                <!-- Y Button (Yellow) -->
                <Ellipse x:Name="YHalo" Width="40" Height="40" Canvas.Left="-20" Canvas.Top="-50" Fill="#FFE600" Opacity="0"/>
                <Ellipse x:Name="YBtn" Width="32" Height="32" Canvas.Left="-16" Canvas.Top="-46" Fill="#FFE600" Stroke="#000000" StrokeThickness="3"/>
                <TextBlock x:Name="YText" Text="Y" Foreground="#000000" FontSize="14" FontWeight="Black" Canvas.Left="-6" Canvas.Top="-40"/>

                <!-- X Button (Cyan) -->
                <Ellipse x:Name="XHalo" Width="40" Height="40" Canvas.Left="-50" Canvas.Top="-20" Fill="#00F0FF" Opacity="0"/>
                <Ellipse x:Name="XBtn" Width="32" Height="32" Canvas.Left="-46" Canvas.Top="-16" Fill="#00F0FF" Stroke="#000000" StrokeThickness="3"/>
                <TextBlock x:Name="XText" Text="X" Foreground="#000000" FontSize="14" FontWeight="Black" Canvas.Left="-36" Canvas.Top="-10"/>

                <!-- B Button (Red/Coral) -->
                <Ellipse x:Name="BHalo" Width="40" Height="40" Canvas.Left="10" Canvas.Top="-20" Fill="#FF3860" Opacity="0"/>
                <Ellipse x:Name="BBtn" Width="32" Height="32" Canvas.Left="14" Canvas.Top="-16" Fill="#FF3860" Stroke="#000000" StrokeThickness="3"/>
                <TextBlock x:Name="BText" Text="B" Foreground="#000000" FontSize="14" FontWeight="Black" Canvas.Left="24" Canvas.Top="-10"/>

                <!-- A Button (Mint) -->
                <Ellipse x:Name="AHalo" Width="40" Height="40" Canvas.Left="-20" Canvas.Top="10" Fill="#00FF85" Opacity="0"/>
                <Ellipse x:Name="ABtn" Width="32" Height="32" Canvas.Left="-16" Canvas.Top="14" Fill="#00FF85" Stroke="#000000" StrokeThickness="3"/>
                <TextBlock x:Name="AText" Text="A" Foreground="#000000" FontSize="14" FontWeight="Black" Canvas.Left="-6" Canvas.Top="20"/>
            </Canvas>

            <!-- Retro Stamp Badge -->
            <Border Canvas.Left="232" Canvas.Top="270" Background="#FFE600" BorderBrush="#000000" BorderThickness="2" Padding="6,2">
                <TextBlock Text="XBOX 360" Foreground="#000000" FontSize="10" FontWeight="Black"/>
            </Border>
        </Canvas>
    </Viewbox>
</UserControl>
